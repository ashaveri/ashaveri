{
  "name": "@ashaveri/sdk",
  "version": "0.1.0",
  "description": "Client SDK for Ashaveri verifiable inference: OpenAI-compatible calls with cryptographic receipts",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ashaveri/receipt": "workspace:*"
  },
  "peerDependencies": {
    "openai": ">=4"
  },
  "peerDependenciesMeta": {
    "openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ashaveri/signerd": "workspace:*",
    "@types/node": "^22.20.1",
    "openai": "^7.13.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
