{
  "name": "@ashaveri/cli",
  "version": "0.1.0",
  "description": "Command-line verification of dStack confidential-VM attestations",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "ashaveri": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "node scripts/bundle.mjs",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json && tsc -p tsconfig.scripts.json",
    "measure:erasure-pass": "node --experimental-strip-types scripts/erasure-pass/measure.ts"
  },
  "dependencies": {
    "@ashaveri/attest-core": "workspace:*",
    "@ashaveri/receipt": "workspace:*",
    "@ashaveri/sdk": "workspace:*",
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "@ashaveri/signerd": "workspace:*",
    "@types/node": "^22.20.1",
    "esbuild": "0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
