Ashaveri-Receipt = #6.18(COSE_Sign1-COSE)

; COSE_Sign1 per RFC 9052 section 4.2, encoded per RFC 8949
; deterministic CBOR (Core Deterministic Encoding, section 4.2.1)
COSE_Sign1-COSE = [
    protected: bstr .cbor Ashaveri-Protected-Header,
    unprotected: { * any => any }, ; the map that carries no claim; see the note below the payload
    payload: bstr .cbor Ashaveri-Receipt-Payload,
    signature: bstr .size 64
]

Ashaveri-Protected-Header = {
    1: -8,                    ; alg: EdDSA (Ed25519)
    4: bstr .size 32,         ; kid: sha256(public_key)
    3: "ashaveri/receipt",    ; typ
}

; A receipt's version says what its fields attest, not which software wrote them. v2 is v1's
; thirteen fields plus `mk`, and a v1 reader that ignored the addition would verify a receipt
; whose response carries no mark while its holder believed it carried one. Silence must not read
; as compliance, so the mark is a new version rather than an optional member of v1.
;
; A payload map is closed at both versions, and the absence of `...` in the two blocks below is
; that rule rather than an oversight: a member the version a document names does not define,
; including one the other version defines, makes the document invalid. It is not read with the
; unexpected member dropped.
Ashaveri-Receipt-Payload = Ashaveri-Receipt-Payload-v1 / Ashaveri-Receipt-Payload-v2

Ashaveri-Receipt-Payload-v1 = {
    v: 1,                     ; format version
    iss: tstr,                ; deployment id (dStack compose-hash prefix)
    ins: tstr,                ; CVM instance id
    iat: int,                 ; unix seconds, issuance time
    nce: bstr .size 16,       ; client nonce, echoed for anti-replay
    req: bstr .size 32,       ; sha256(canonical request)
    res: bstr .size 32,       ; sha256(full response bytes, incl. SSE frames)
    mdl: tstr,                ; model id, e.g. "meta-llama/Llama-3.1-8B-Instruct"
    wts: bstr .size 32,       ; sha256(deployment manifest: weights + image + config)
    meas: Measurement,
    att: EvidenceRef,
    epk: int,                 ; signing-key epoch
    tok: TokenMetering,
}

Ashaveri-Receipt-Payload-v2 = {
    v: 2,                     ; format version
    ; every v: 1 field, unchanged in name, order, width and meaning:
    iss: tstr, ins: tstr, iat: int, nce: bstr .size 16,
    req: bstr .size 32, res: bstr .size 32, mdl: tstr, wts: bstr .size 32,
    meas: Measurement, att: EvidenceRef, epk: int, tok: TokenMetering,
    mk: Marking,              ; required: v2 attests that marking was considered
}

; That rule is the format's, not one map's. `Marking`, `Measurement`, `EvidenceRef` and
; `TokenMetering` below carry no `...` either, and the absence means there what it means here: a
; member one of these maps does not define makes the document invalid rather than a document read
; with the unexpected member dropped. The parser and the JSON twin refuse it at that level exactly as
; they refuse one at the payload level, so the payload map and every map nested inside it close, at
; both versions. `Ashaveri-Protected-Header` closes with them, and its reason is stronger than the
; payload's: its bytes are the ones hashed into the `Sig_structure`, so a label that block does not
; name is an authenticated parameter, and a reader that took the three labels above out of it and
; returned those handed on a document other than the one the issuer signed. The parser refuses the
; unknown label by number, at that level, before it reads any of the three. Numbers close it, not names
; this file recognises, so the rule takes in the parameters RFC 9052 registers as well: label 2, `crit`,
; by which a sender asks that a recipient understand something about the message, is refused in the
; signed header as any other label the block does not name. Nothing in this format answers such an ask,
; and not because the number is unknown to it: the header refuses it, and the map outside the signature
; is free to hold one and carries no claim of the document either way.
;
; One map this file leaves a signer free to fill, and that is a decision rather than a gap: the
; `unprotected` map of `COSE_Sign1-COSE` sits outside the signature, so nothing written in it can
; travel as a claim about the response, and a rule enforcing its emptiness would buy strictness with
; no security content behind it. What the format declares of it is therefore only that it carries no
; claim, which is what `{ * any => any }` there says and `{}` did not.

; Every number this file writes `int` is a CBOR integer, major type 0 or 1, and no other major type
; carries one. A floating-point number whose value happens to be a whole number is not an integer
; written awkwardly: it is a different type, and the reader that takes the two apart while it is
; reading is the only one that ever can, because a decoder that hands both over as one JavaScript
; number leaves a check placed afterwards nothing to distinguish. So the payload and the protected
; header, the two blocks above whose every member is named here, are decoded where no floating-point
; number may appear, in a value and in a key alike. That is as wide as those two blocks and no
; wider: nothing either of them declares can be a float, so no document that follows this file is
; refused by the rule. The map left free above keeps its freedom, and a number in it is not an
; integer in disguise, because nothing there is declared to be one.
;
; A key is why the rule cannot sit beside the reads instead of inside the decode. `Ashaveri-Protected-Header`
; names its members by the integers RFC 9052 registers, and a key written as the half-float 1.0 decodes
; to the same map slot as the integer 1, so a reader looking at the finished map sees one entry where
; the signed bytes carry two, and which value it sees depends on the order they were written in. Core
; deterministic ordering puts the one-byte integer first and the three-byte float last, so the float's
; value is the one that survives every time. That is not a header carrying a label this block does not
; name, and it is not a suite this format does not sign with: it is a header whose parameters are not
; the ones the signature covers, which is what the rule above refuses, at the point the bytes are read.

; Absence is declared here rather than inferred from a missing member: `sch: "none"` carries the
; digest of the empty region, so `mk` is never optional and a reader never has to decide what an
; omitted field meant.
Marking = {
    sch: "none" / tstr,       ; a label from the marking-scheme registry
    d: bstr .size 32,         ; sha256 of the marked region, exactly as it appears in the response
}

Measurement = {
    tee: "software",
    m: bstr .size 32,          ; SHA-256, the deployment's own digest
} / {
    tee: "snp" / "snp+gpucc" / "tdx" / "tdx+gpucc",
    m: bstr .size 48,          ; the platform's native SHA-384 measurement:
                               ; SNP launch digest or TDX MRTD
}

EvidenceRef = {
    d: bstr .size 32,         ; sha256(attestation evidence document)
    ts: int,                  ; evidence timestamp, unix seconds
    url: tstr,                ; where evidence can be fetched and re-verified
}

TokenMetering = {
    p: int,                   ; prompt tokens
    c: int,                   ; completion tokens
}
