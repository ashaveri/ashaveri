Ashaveri-Receipt = #6.18(COSE_Sign1-COSE)

; COSE_Sign1 per RFC 9052 section 4.2, encoded per RFC 8949
; deterministic CBOR (Core Deterministic Encoding, section 4.2.1)
COSE_Sign1-COSE = [
    protected: bstr .cbor Ashaveri-Protected-Header,
    unprotected: {},
    payload: bstr .cbor Ashaveri-Receipt-Payload,
    signature: bstr .size 64
]

Ashaveri-Protected-Header = {
    1: -8,                    ; alg: EdDSA (Ed25519)
    4: bstr .size 32,         ; kid: sha256(public_key)
    3: "ashaveri/receipt",    ; typ
}

; A receipt's version says what its fields attest, not which software wrote them. v2 is v1's
; thirteen fields plus `mk`, and a v1 reader that ignored the addition would verify a receipt
; whose response carries no mark while its holder believed it carried one. Silence must not read
; as compliance, so the mark is a new version rather than an optional member of v1.
;
; A payload map is closed at both versions, and the absence of `...` in the two blocks below is
; that rule rather than an oversight: a member the version a document names does not define,
; including one the other version defines, makes the document invalid. It is not read with the
; unexpected member dropped.
Ashaveri-Receipt-Payload = Ashaveri-Receipt-Payload-v1 / Ashaveri-Receipt-Payload-v2

Ashaveri-Receipt-Payload-v1 = {
    v: 1,                     ; format version
    iss: tstr,                ; deployment id (dStack compose-hash prefix)
    ins: tstr,                ; CVM instance id
    iat: int,                 ; unix seconds, issuance time
    nce: bstr .size 16,       ; client nonce, echoed for anti-replay
    req: bstr .size 32,       ; sha256(canonical request)
    res: bstr .size 32,       ; sha256(full response bytes, incl. SSE frames)
    mdl: tstr,                ; model id, e.g. "meta-llama/Llama-3.1-8B-Instruct"
    wts: bstr .size 32,       ; sha256(deployment manifest: weights + image + config)
    meas: Measurement,
    att: EvidenceRef,
    epk: int,                 ; signing-key epoch
    tok: TokenMetering,
}

Ashaveri-Receipt-Payload-v2 = {
    v: 2,                     ; format version
    ; every v: 1 field, unchanged in name, order, width and meaning:
    iss: tstr, ins: tstr, iat: int, nce: bstr .size 16,
    req: bstr .size 32, res: bstr .size 32, mdl: tstr, wts: bstr .size 32,
    meas: Measurement, att: EvidenceRef, epk: int, tok: TokenMetering,
    mk: Marking,              ; required: v2 attests that marking was considered
}

; Closedness stops at the payload map: `Marking`, `Measurement`, `EvidenceRef` and `TokenMetering`
; are open, so a member inside one of them that its block does not name is dropped, not refused.

; Absence is declared here rather than inferred from a missing member: `sch: "none"` carries the
; digest of the empty region, so `mk` is never optional and a reader never has to decide what an
; omitted field meant.
Marking = {
    sch: "none" / tstr,       ; a label from the marking-scheme registry
    d: bstr .size 32,         ; sha256 of the marked region, exactly as it appears in the response
}

Measurement = {
    tee: "software",
    m: bstr .size 32,          ; SHA-256, the deployment's own digest
} / {
    tee: "snp" / "snp+gpucc" / "tdx" / "tdx+gpucc",
    m: bstr .size 48,          ; the platform's native SHA-384 measurement:
                               ; SNP launch digest or TDX MRTD
}

EvidenceRef = {
    d: bstr .size 32,         ; sha256(attestation evidence document)
    ts: int,                  ; evidence timestamp, unix seconds
    url: tstr,                ; where evidence can be fetched and re-verified
}

TokenMetering = {
    p: int,                   ; prompt tokens
    c: int,                   ; completion tokens
}
