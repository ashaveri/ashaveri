Ashaveri-Receipt = #6.18(COSE_Sign1-COSE)

; COSE_Sign1 per RFC 9052 section 4.2, encoded per RFC 8949
; deterministic CBOR (Core Deterministic Encoding, section 4.2.1)
COSE_Sign1-COSE = [
    protected: bstr .cbor Ashaveri-Protected-Header,
    unprotected: { * any => any }, ; the map that carries no claim; see the note below the payload
    payload: bstr .cbor Ashaveri-Receipt-Payload,
    signature: bstr .size 64
]

Ashaveri-Protected-Header = {
    1: -8,                    ; alg: EdDSA (Ed25519)
    4: bstr .size 32,         ; kid: sha256(public_key)
    3: "ashaveri/receipt",    ; typ
}

; A receipt's version says what its fields attest, not which software wrote them. This format declares
; one version, `v: 1`, and it carries the seventeen members the three numbers it replaced used to spell
; out: the twelve a document has always carried, then `mk` so a mark is attested rather than passed over,
; then `sd` (the source the issuance stamp was read from and the bound that source declares on itself),
; `cva` (what became of the two pieces of context the appraisal of the evidence ran on) and `itm` (one
; entry per response item). No member changed name, order, width or meaning in the collapse, and none was
; added.
;
; A version number moves when bytes carrying the old number exist that a reader must refuse, and not
; otherwise. Nothing outside this repository has ever held a receipt: `@ashaveri/receipt` is unpublished,
; the package version is `0.1.0`, and no party was handed a document bearing `1`, `2` or `3`. So the
; history those three numbers told was internal, and the members stayed while the number that named them
; was settled on the one a reader of these bytes has to be able to open. Silence is still what each of the
; five added members refuses: a reader that took a mark, a stamp's source, an appraisal's context and a
; response's items and dropped them would verify a receipt that states nothing about any of them, and a
; receipt is a document that states. That is why all five are required rather than optional members of
; the number that has always been read.
;
; A payload map is closed, and the absence of `...` below is that rule rather than an oversight: a member
; this file does not define, including one a retired number used to name, makes the document invalid. It
; is not read with the unexpected member dropped. A document naming any number but `1` is refused as a
; version, with the number named back to the reader, before one member of it is read.
Ashaveri-Receipt-Payload = Ashaveri-Receipt-Payload-v1

Ashaveri-Receipt-Payload-v1 = {
    v: 1,                     ; the one version this format declares
    iss: tstr,                ; deployment id (dStack compose-hash prefix)
    ins: tstr,                ; CVM instance id
    iat: int,                 ; unix seconds, issuance time
    nce: bstr .size 16,       ; client nonce, echoed for anti-replay
    req: bstr .size 32,       ; sha256(canonical request)
    res: bstr .size 32,       ; sha256(full response bytes, incl. SSE frames)
    mdl: tstr,                ; model id, e.g. "meta-llama/Llama-3.1-8B-Instruct"
    wts: bstr .size 32,       ; sha256(deployment manifest: weights + image + config)
    meas: Measurement,
    att: EvidenceRef,
    epk: int,                 ; signing-key epoch
    tok: TokenMetering,
    mk: Marking,              ; required: a receipt attests that marking was considered
    sd: StampDisclosure,      ; what source read the issuance stamp, and what it admits
    cva: CollateralValidityAnchor, ; what became of the context the appraisal ran on
    itm: [+ ItemStamp],       ; one entry per response item, and never an empty list
}

; That rule is the format's, not one map's. `Marking`, `Measurement`, `EvidenceRef`,
; `TokenMetering`, `StampDisclosure`, `CollateralValidityAnchor`, `CollateralHeld`,
; `CollateralAbsent` and `ItemStamp` below carry no `...` either, and the absence means there what
; it means here: a member one of these maps does not define makes the document invalid rather than
; a document read with the unexpected member dropped. The parser and the JSON twin refuse it at that
; level exactly as they refuse one at the payload level, so the payload map and every map nested
; inside it close at every level. The one position the walk cannot close by itself is `itm`,
; whose value is an array rather than a map: its elements are closed one at a time by the reader
; that reads them, at the position each one sits at, which is what `ItemStamp` names. `p` closes the
; two slot maps the same way, because which member list stands behind `cva.col` is decided by the
; label that member carries and no single list can answer for both arms.
; `Ashaveri-Protected-Header` closes with them, and its reason is stronger than the
; payload's: its bytes are the ones hashed into the `Sig_structure`, so a label that block does not
; name is an authenticated parameter, and a reader that took the three labels above out of it and
; returned those handed on a document other than the one the issuer signed. The parser refuses the
; unknown label by number, at that level, before it reads any of the three. Numbers close it, not names
; this file recognises, so the rule takes in the parameters RFC 9052 registers as well: label 2, `crit`,
; by which a sender asks that a recipient understand something about the message, is refused in the
; signed header as any other label the block does not name. Nothing in this format answers such an ask,
; and not because the number is unknown to it: the header refuses it, and the map outside the signature
; is free to hold one and carries no claim of the document either way.
;
; One map this file leaves a signer free to fill, and that is a decision rather than a gap: the
; `unprotected` map of `COSE_Sign1-COSE` sits outside the signature, so nothing written in it can
; travel as a claim about the response, and a rule enforcing its emptiness would buy strictness with
; no security content behind it. What the format declares of it is therefore only that it carries no
; claim, which is what `{ * any => any }` there says and `{}` did not.

; Every number this file writes `int` is a CBOR integer, major type 0 or 1, and no other major type
; carries one. A floating-point number whose value happens to be a whole number is not an integer
; written awkwardly: it is a different type, and the reader that takes the two apart while it is
; reading is the only one that ever can, because a decoder that hands both over as one JavaScript
; number leaves a check placed afterwards nothing to distinguish. So the payload and the protected
; header, the two blocks above whose every member is named here, are decoded where no floating-point
; number may appear, in a value and in a key alike. That is as wide as those two blocks and no
; wider: nothing either of them declares can be a float, so no document that follows this file is
; refused by the rule. The map left free above keeps its freedom, and a number in it is not an
; integer in disguise, because nothing there is declared to be one.
;
; A key is why the rule cannot sit beside the reads instead of inside the decode. `Ashaveri-Protected-Header`
; names its members by the integers RFC 9052 registers, and a key written as the half-float 1.0 decodes
; to the same map slot as the integer 1, so a reader looking at the finished map sees one entry where
; the signed bytes carry two, and which value it sees depends on the order they were written in. Core
; deterministic ordering puts the one-byte integer first and the three-byte float last, so the float's
; value is the one that survives every time. That is not a header carrying a label this block does not
; name, and it is not a suite this format does not sign with: it is a header whose parameters are not
; the ones the signature covers, which is what the rule above refuses, at the point the bytes are read.

; Absence is declared here rather than inferred from a missing member: `sch: "none"` carries the
; digest of the empty region, so `mk` is never optional and a reader never has to decide what an
; omitted field meant.
Marking = {
    sch: "none" / tstr,       ; a label from the marking-scheme registry
    d: bstr .size 32,         ; sha256 of the marked region, exactly as it appears in the response
}

Measurement = {
    tee: "software",
    m: bstr .size 32,          ; SHA-256, the deployment's own digest
} / {
    tee: "snp" / "snp+gpucc" / "tdx" / "tdx+gpucc",
    m: bstr .size 48,          ; the platform's native SHA-384 measurement:
                               ; SNP launch digest or TDX MRTD
}

EvidenceRef = {
    d: bstr .size 32,         ; sha256(attestation evidence document)
    ts: int,                  ; evidence timestamp, unix seconds
    url: tstr,                ; where evidence can be fetched and re-verified
}

TokenMetering = {
    p: int,                   ; prompt tokens
    c: int,                   ; completion tokens
}

; Where the issuance instant came from, in the source's own words. This block, and nothing else in
; the estate, is where the two wire labels are tied to the shape in `src/disclosure.ts`: `name` is
; `StampDisclosure.name`, the name the source's owner gives what this process reads, and `unc` is
; `StampDisclosure.uncertaintySeconds`, the seconds that source declares it can be away from the
; instant it names. The instant is not here: it stays where it already is, and a second copy of one
; signed fact in one document would be two owners of it with only one of them signed.
;
; `unc` is `null` where nobody measured how far this source can stand from the truth, and `null` is
; written rather than left out because an absent bound has two readings and a document cannot say
; which one it meant. Zero is a source claiming it is right; `null` is a source saying nothing here
; knows. Those are two states, not two spellings of one: a policy that demands a bound refuses the
; second and can accept the first, which is exactly how the policy's own uncertainty figure and its
; refusal already treat the pair. A floating-point number is refused at this position as it is at
; every other one in a map whose every member this file names, by the decode rather than by a check
; placed after it.
StampDisclosure = {
    name: tstr,               ; what the source's owner calls it
    unc: int / null,          ; seconds it admits it can be away by, or null that nobody measured
}

; What became of the two pieces of appraisal context the evidence was read against, captured when
; they were taken in and read offline ever after. The mapping from `src/disclosure.ts` is stated
; here and nowhere else: `col` is `CollateralValidityAnchor.collateral`, the signed collateral those
; bytes were appraised against, and `val` is `CollateralValidityAnchor.validity`, the validity
; context they were appraised in. Both are required, because an anchor that defaults a missing half
; to a pass is not an anchor, and a half this document does not mention would be a hole wearing the
; shape of a state.
CollateralValidityAnchor = {
    col: CollateralSlot,      ; the collateral the appraisal ran against
    val: CollateralSlot,      ; the validity context it ran in
}

; Which of the two shapes a slot has is its `p`, and the reader that resolves `p` is what closes the
; map, because a choice between two member sets is not one member list. The three labels are the
; capture record's `CapturePresence`, restated as this format's own bytes and held to that source by
; a test that reads it: `held`, `absent-at-source`, and `not-taken-in`. The last two are not one
; label and neither is the first: one absence is a statement about the world, the other a statement
; about this collector, and a record that could not tell them apart could not be read as either. An
; absent slot carries a reason and no digest, because a digest of bytes nobody held is not a
; statement about anything; a held slot carries a digest and no reason, and it carries no byte count
; either, because a count of bytes this document does not hold is a number nothing can check. No arm
; of either carries a verdict: whether the collateral verifies is a question a reader asks with its
; own pins, and a signed record that printed the conclusion would turn custody of bytes into
; verification of them.
CollateralSlot = CollateralHeld / CollateralAbsent
CollateralHeld = {
    p: "held",                ; these bytes were taken in, and this digest is of them
    d: bstr .size 32,         ; sha256 of the bytes exactly as they arrived, and of no bytes with them
}
CollateralAbsent = {
    p: "absent-at-source" / "not-taken-in",   ; which of the two absences this is
    r: tstr,                  ; in one line, the collector's own words for why there are no bytes
}

; One entry per response item, in the order the response put its items in. `d` is `ResponseItem.d`
; from `src/response-items.ts`: sha256 of exactly one item's bytes and of none of the framing around
; them. The instant has no shape to map from, because nothing in this tree stamps one yet: it is what
; the source `sd` names read when those bytes were framed, in the same whole Unix seconds as the
; issuance stamp and from the same source that read that one. An item is a protocol item, one `data:`
; frame of a streamed response or the whole body of one that was not streamed, and section 3.1 of
; `docs/receipt-spec.md` states both the framing and which digests cover which bytes.
;
; Chain order is the array's order. An item has no identity beside its digest for a chain to name a
; predecessor by, so the list itself is the chain, and the order is the one the response wrote. Stamp
; order is `t`. Where the two disagree a reader refuses the receipt, under a code of its own and not
; under the payload's, because the members are all well-formed and it is the pair of signed
; statements inside them that cannot both stand. What that check cannot reach is stated in the same
; document as what it can: a source standing uniformly away from the truth moves every one of these
; instants together, leaves the list tidy, and passes. That is inherent to a store that cannot see
; outside the clock it reads, and it is why this member discloses the source rather than only the
; numbers.
ItemStamp = {
    t: int,                   ; unix seconds, the instant this item's bytes were stamped
    d: bstr .size 32,         ; sha256 of exactly those bytes
}
