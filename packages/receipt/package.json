{
  "name": "@ashaveri/receipt",
  "version": "0.1.0",
  "description": "Deterministic CBOR + COSE_Sign1 receipt codec for verifiable AI inference",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "receipt.cddl",
    "pack.cddl",
    "export.cddl",
    "manifest.cddl",
    "schemas"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^2.0.0",
    "cbor2": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "ajv": "^8.20.0",
    "fast-check": "^4.10.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
