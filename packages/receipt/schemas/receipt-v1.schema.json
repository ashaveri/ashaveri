{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ashaveri.com/schemas/receipt.json",
  "title": "Ashaveri Inference Receipt (JSON twin of the CBOR/COSE wire format)",
  "description": "Display-only projection of the signed COSE_Sign1 receipt. The CBOR bytes are canonical; this JSON form is never signed directly. The payload branch describes both versions the CDDL defines: receipt-v1's thirteen fields, and receipt-v2, which is those same fields plus the marking attestation.",
  "type": "object",
  "required": ["protectedHeader", "payload"],
  "properties": {
    "protectedHeader": {
      "type": "object",
      "required": ["alg", "kid", "typ"],
      "properties": {
        "alg": { "const": "EdDSA", "description": "COSE algorithm -8, Ed25519" },
        "kid": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "sha256 of the Ed25519 public key, hex" },
        "typ": { "const": "ashaveri/receipt" }
      }
    },
    "payload": {
      "description": "Exactly one branch per payload version. `v` is which one the document is, and the branches are exclusive on it.",
      "oneOf": [
        { "$ref": "#/$defs/payloadV1" },
        { "$ref": "#/$defs/payloadV2" }
      ]
    },
    "signature": { "type": "string", "pattern": "^[0-9a-f]{128}$", "description": "Ed25519 signature over the Sig_structure, hex" }
  },
  "$defs": {
    "payloadFields": {
      "type": "object",
      "required": ["iss", "ins", "iat", "nce", "req", "res", "mdl", "wts", "meas", "att", "epk", "tok"],
      "properties": {
        "iss": { "type": "string", "description": "deployment id (dStack compose-hash prefix)" },
        "ins": { "type": "string", "description": "CVM instance id" },
        "iat": { "type": "integer", "description": "issuance time, unix seconds" },
        "nce": { "$ref": "#/$defs/hex16", "description": "client nonce, echoed" },
        "req": { "$ref": "#/$defs/hex32", "description": "sha256 of canonical request" },
        "res": { "$ref": "#/$defs/hex32", "description": "sha256 of full response bytes" },
        "mdl": { "type": "string", "description": "model id" },
        "wts": { "$ref": "#/$defs/hex32", "description": "sha256 of deployment manifest" },
        "meas": {
          "type": "object",
          "required": ["tee", "m"],
          "properties": {
            "tee": { "enum": ["software", "snp", "snp+gpucc", "tdx", "tdx+gpucc"] },
            "m": {
              "$ref": "#/$defs/hexDigest",
              "description": "SHA-256 for a software deployment, the platform's SHA-384 measurement for a TEE"
            }
          },
          "allOf": [
            {
              "if": { "required": ["tee"], "properties": { "tee": { "const": "software" } } },
              "then": { "properties": { "m": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } }
            },
            {
              "if": { "required": ["tee"], "properties": { "tee": { "enum": ["snp", "snp+gpucc", "tdx", "tdx+gpucc"] } } },
              "then": { "properties": { "m": { "type": "string", "pattern": "^[0-9a-f]{96}$" } } }
            }
          ]
        },
        "att": {
          "type": "object",
          "required": ["d", "ts", "url"],
          "properties": {
            "d": { "$ref": "#/$defs/hex32", "description": "sha256 of attestation evidence document" },
            "ts": { "type": "integer", "description": "evidence timestamp, unix seconds" },
            "url": { "type": "string", "format": "uri" }
          }
        },
        "epk": { "type": "integer", "minimum": 0, "description": "signing-key epoch" },
        "tok": {
          "type": "object",
          "required": ["p", "c"],
          "properties": {
            "p": { "type": "integer", "minimum": 0, "description": "prompt tokens" },
            "c": { "type": "integer", "minimum": 0, "description": "completion tokens" }
          }
        }
      }
    },
    "payloadV1": {
      "allOf": [{ "$ref": "#/$defs/payloadFields" }],
      "type": "object",
      "required": ["v"],
      "properties": {
        "v": { "const": 1 }
      }
    },
    "payloadV2": {
      "allOf": [{ "$ref": "#/$defs/payloadFields" }],
      "type": "object",
      "required": ["v", "mk"],
      "properties": {
        "v": { "const": 2 },
        "mk": {
          "type": "object",
          "required": ["sch", "d"],
          "properties": {
            "sch": {
              "type": "string",
              "description": "a label from the marking-scheme registry. Not an enum here because the CDDL admits any tstr: the registry this package reads is `none` and `provenance-v1`, and it refuses a label outside those two as UNSUPPORTED_SCHEME rather than this twin deciding the format."
            },
            "d": {
              "$ref": "#/$defs/hex32",
              "description": "sha256 of the marked region exactly as it appears in the response, not of the whole response. For `sch: \"none\"` the region is empty and this is the digest of no bytes."
            }
          }
        }
      }
    },
    "hex16": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "hex32": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "hexDigest": { "type": "string", "pattern": "^([0-9a-f]{64}|[0-9a-f]{96})$" }
  }
}
