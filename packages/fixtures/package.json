{
  "name": "@ashaveri/fixtures",
  "version": "0.1.0",
  "description": "Golden conformance vectors for Ashaveri receipt verification (shared across TS, Python, and CLI implementations)",
  "license": "CC0-1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "data"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashaveri/ashaveri.git",
    "directory": "packages/fixtures"
  },
  "bugs": {
    "url": "https://github.com/ashaveri/ashaveri/issues"
  },
  "homepage": "https://github.com/ashaveri/ashaveri#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json && tsc -p tsconfig.scripts.json",
    "generate": "node scripts/generate.ts",
    "generate:pop": "node scripts/pop-vectors.ts",
    "generate:req": "node scripts/req-vectors.ts",
    "generate:res": "node scripts/res-vectors.ts",
    "generate:marking": "node scripts/marking-vectors.ts",
    "generate:chain": "node scripts/chain-vectors.ts",
    "generate:export": "node scripts/export-vectors.ts",
    "generate:manifest": "node scripts/manifest-vectors.ts",
    "generate:pack": "node scripts/pack-vectors.ts",
    "generate:redaction": "node scripts/redaction-vectors.ts",
    "generate:epoch-inventory": "node scripts/epoch-inventory-vectors.ts",
    "generate:capture": "node scripts/capture-vectors.ts",
    "generate:import": "node scripts/import-vectors.ts",
    "generate:retention-assessment": "node scripts/retention-assessment-vectors.ts"
  },
  "dependencies": {
    "@ashaveri/receipt": "workspace:*",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "@ashaveri/sdk": "workspace:*",
    "@ashaveri/signerd": "workspace:*",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
