{
  "name": "@ashaveri/fixtures",
  "version": "0.1.0",
  "description": "Golden conformance vectors for Ashaveri receipt verification (shared across TS, Python, and CLI implementations)",
  "license": "CC0-1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "generate": "node --experimental-strip-types scripts/generate.ts",
    "generate:pop": "node --experimental-strip-types scripts/pop-vectors.ts",
    "generate:req": "node --experimental-strip-types scripts/req-vectors.ts",
    "generate:res": "node --experimental-strip-types scripts/res-vectors.ts",
    "generate:chain": "node --experimental-strip-types scripts/chain-vectors.ts"
  },
  "dependencies": {
    "@ashaveri/receipt": "workspace:*",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "@ashaveri/signerd": "workspace:*",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
