{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["node"],
    // The generators are run from source by `node --experimental-strip-types`, which resolves
    // specifiers as written and so requires `./seed.ts`; the checked path has to accept the one
    // spelling the running path allows. `noEmit` above is what makes the extension legal at all.
    "allowImportingTsExtensions": true
  },
  "include": ["scripts"]
}
