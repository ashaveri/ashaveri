{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // scripts/pack-vectors.ts reaches the collateral package's own test support for the fixture vendor its
    // served pair is signed by, exactly as packages/cli/scripts/offline-proof.ts and
    // packages/cli/test/carried-collateral.test.ts already do, so the root has to span the workspace rather
    // than this package. Nothing here is emitted, which is why widening it settles the check rather than
    // moving an output.
    "rootDir": "../..",
    "types": ["node"],
    // The generators are run from source by `node --experimental-strip-types`, which resolves
    // specifiers as written and so requires `./seed.ts`; the checked path has to accept the one
    // spelling the running path allows. `noEmit` above is what makes the extension legal at all.
    "allowImportingTsExtensions": true,
    // The same loader refuses `enum`, a runtime `namespace` and a constructor parameter property
    // outright, and the job that regenerates the vectors typechecks this config before it runs one:
    // without the option a script can pass every other check here and fail that run.
    "erasableSyntaxOnly": true
  },
  "include": ["scripts"]
}
