{
  "name": "@ashaveri/signerd",
  "version": "0.1.0",
  "description": "Receipt-signing gateway for the Ashaveri verifiable inference stack, in mock mode or on a live dStack confidential VM",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "bin": {
    "signerd": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@ashaveri/attest-core": "workspace:*",
    "@ashaveri/receipt": "workspace:*",
    "@noble/hashes": "^2.4.0",
    "fastify": "^5.12.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "fast-check": "^4.10.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
